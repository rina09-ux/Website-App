# Public website -> canonical NusaSec services.
# These values are safe public endpoints. Never put secrets in VITE_* variables.
VITE_NUSASEC_PUBLIC_WEBSITE_URL="https://nusasec.com"
VITE_NUSASEC_CORE_API_URL="https://api.nusasec.com"
VITE_NUSASEC_AI_API_URL="https://ai.nusasec.com"
VITE_NUSASEC_CUSTOMER_APP_URL="https://app.nusasec.com"
VITE_NUSASEC_INTERNAL_APP_URL="https://internal.nusasec.com"

# Optional local-development override for the AI gateway.
# Keep production AI credentials out of the browser build.
VITE_NUSASEC_AI_PUBLIC_ENABLED="true"

# Legacy AI Studio variables are retained only for local experiments.
# Do not expose production secrets through VITE_* variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
